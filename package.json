  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rgfaber"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "macula",
    "mesh",
    "agent",
    "claude"
  ],
  "author": {
    "name": "Macula",
    "email": "raf.lefever@erlef.org"
  },
  "bin": {
    "macula-mcp": "dist/index.js",
    "macula-mcp-install": "dist/bin/install.js",
    "macula-mcp-uninstall": "dist/bin/uninstall.js",
