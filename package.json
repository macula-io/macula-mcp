{
  "name": "@macula-io/mcp",
  "version": "0.5.0",
  "description": "Model Context Protocol server that exposes the Macula mesh to any agent harness, via macula-cli",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/macula-io/macula-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macula-io/macula-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/macula-io/macula-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "macula",
    "mesh",
    "agent",
    "claude"
  ],
  "author": {
    "name": "Macula",
    "email": "raf.lefever@erlef.org"
  },
  "bin": {
    "macula-mcp": "dist/index.js",
    "macula-mcp-install": "dist/bin/install.js",
    "macula-mcp-uninstall": "dist/bin/uninstall.js",
    "macula-mcp-status": "dist/bin/status.js",
    "macula-mcp-doctor": "dist/bin/doctor.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
