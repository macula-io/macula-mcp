{
  "name": "@macula-io/mcp",
  "version": "0.19.0",
  "description": "Model Context Protocol server that exposes the Macula mesh to any agent harness",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/macula-io/macula-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macula-io/macula-mcp.git"
  },
  "bugs": {
